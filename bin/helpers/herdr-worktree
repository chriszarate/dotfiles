#!/usr/bin/env bash
#
# Keep herdr workspaces in step with worktrunk worktrees.
#
# Called by the worktrunk hooks in worktrunk/config.toml. Outside of herdr it
# does nothing, so those hooks are harmless in a plain terminal.
#
#   herdr-worktree open <repo-path> <worktree-path>  Open, or focus, a workspace
#   herdr-worktree close <worktree-path>             Close the workspace
#   herdr-worktree pane <worktree-path>              Print the workspace's root pane
#
# open focuses the workspace for a person at the keyboard. When an agent is
# driving (CLAUDECODE is set, or HERDR_WORKTREE_NO_FOCUS=1), the workspace
# opens in the background so the person's view stays put.

set -uo pipefail

subcommand="${1:-}"
shift 2> /dev/null

# How long to wait for a removed worktree to disappear, in fifths of a second.
close_timeout="${HERDR_WORKTREE_CLOSE_TIMEOUT:-300}"

# How long to wait for a workspace to appear after wt returns, in fifths of a
# second. The post-switch hook that opens it runs in the background.
pane_timeout="${HERDR_WORKTREE_PANE_TIMEOUT:-50}"

focus_flag="--focus"
if [ -n "${HERDR_WORKTREE_NO_FOCUS:-}" ] || [ -n "${CLAUDECODE:-}" ]; then
	focus_flag="--no-focus"
fi

# Only herdr sets HERDR_ENV, so this is how we know there's a session to talk to.
if [ -z "${HERDR_ENV:-}" ] || ! command -v herdr > /dev/null; then
	exit 0
fi

case "$subcommand" in

	open)
		repo_path="${1:-}"
		worktree_path="${2:-}"

		if [ -z "$repo_path" ] || [ -z "$worktree_path" ]; then
			echo "herdr-worktree: open needs a repo path and a worktree path" >&2
			exit 1
		fi

		# herdr focuses the existing workspace when the worktree is already
		# open, and it treats the repository root as the source workspace, so
		# this one call covers creating, switching, and switching back to main.
		#
		# "Already open" includes any workspace whose shell is sitting in the
		# worktree directory, so the calling shell must stay put until this
		# runs. The fish wrapper in fish/functions/wt.fish handles that.
		herdr worktree open \
			--cwd "$repo_path" \
			--path "${worktree_path%/}" \
			"$focus_flag" > /dev/null
		;;

	pane)
		worktree_path="${1:-}"

		if [ -z "$worktree_path" ]; then
			echo "herdr-worktree: pane needs a worktree path" >&2
			exit 1
		fi

		waited=0
		while :; do
			workspace_id=$(
				herdr workspace list | jq -r --arg path "${worktree_path%/}" '
					.result.workspaces[]
					| select(.worktree.checkout_path == $path)
					| .workspace_id
				' | head -n 1
			)

			if [ -n "$workspace_id" ]; then
				break
			fi

			if [ "$waited" -ge "$pane_timeout" ]; then
				echo "herdr-worktree: no workspace for $worktree_path" >&2
				exit 1
			fi

			sleep 0.2
			waited=$((waited + 1))
		done

		# The first pane in the workspace is the root pane herdr created,
		# sitting at a shell prompt.
		herdr pane list --workspace "$workspace_id" \
			| jq -re '.result.panes[0].pane_id'
		;;

	close)
		worktree_path="${1:-}"

		if [ -z "$worktree_path" ]; then
			echo "herdr-worktree: close needs a worktree path" >&2
			exit 1
		fi

		# Find the workspace holding this checkout. Only linked worktrees count,
		# so a stray call can never close the main repository's workspace.
		workspace_id=$(
			herdr workspace list | jq -r --arg path "${worktree_path%/}" '
				.result.workspaces[]
				| select(.worktree.checkout_path == $path)
				| select(.worktree.is_linked_worktree)
				| .workspace_id
			'
		)

		if [ -z "$workspace_id" ]; then
			exit 0
		fi

		# wt is still finishing up, and it is running in the pane that closing
		# this workspace kills. Deleting the checkout directory is its last
		# step, so wait for that to happen — closing early cuts the removal
		# short and leaves an empty directory behind. If the checkout is still
		# there when we give up, the removal is in trouble and the workspace is
		# more useful open than closed.
		waited=0
		while [ -e "$worktree_path" ] && [ "$waited" -lt "$close_timeout" ]; do
			sleep 0.2
			waited=$((waited + 1))
		done

		if [ ! -e "$worktree_path" ]; then
			herdr workspace close "$workspace_id" > /dev/null
		fi
		;;

	*)
		echo "usage: herdr-worktree open <repo-path> <worktree-path>" >&2
		echo "       herdr-worktree close <worktree-path>" >&2
		echo "       herdr-worktree pane <worktree-path>" >&2
		exit 1
		;;

esac
