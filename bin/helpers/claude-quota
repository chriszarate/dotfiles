#!/usr/bin/env bash
#
# Print Claude subscription usage for the herdr tab bar, e.g.
#
#   Fable 33% 2d │ Total 7% 14m
#
# Each entry is a limit's percent used and how long until it resets. "Fable" is
# the weekly per-model limit; "Total" is the five-hour limit across all models.
#
# Wired up as a tab_bar_right command entry in herdr/config.toml. Also fine to
# run by hand. The OAuth token is read from the login keychain and never
# printed. Responses are cached briefly so the tab bar and any manual runs
# share one request.

set -uo pipefail

cache="${TMPDIR:-/tmp}/claude-quota.json"
max_age="${CLAUDE_QUOTA_MAX_AGE:-60}"

# Seconds since the file was last written, or a large number if it's missing.
age() {
	if [ -f "$1" ]; then
		echo $(($(date +%s) - $(stat -f %m "$1")))
	else
		echo 999999
	fi
}

if [ "$(age "$cache")" -gt "$max_age" ]; then
	token="$(
		security find-generic-password -s 'Claude Code-credentials' -w 2> /dev/null \
			| jq -r '.claudeAiOauth.accessToken // empty'
	)"

	# Write to a temporary file and only promote it once it parses, so a failed
	# or truncated request leaves the last good response in place.
	if [ -n "$token" ]; then
		if curl -sS --max-time 4 https://api.anthropic.com/api/oauth/usage \
			-H "Authorization: Bearer $token" \
			-H 'anthropic-beta: oauth-2025-04-20' > "$cache.tmp" 2> /dev/null \
			&& jq -e '.limits' "$cache.tmp" > /dev/null 2>&1; then
			mv "$cache.tmp" "$cache"
		fi
		rm -f "$cache.tmp"
	fi
fi

# Anything unreadable degrades to a placeholder. Letting jq fail here would put
# its parse error in the tab bar.
if ! jq -e '.limits' "$cache" > /dev/null 2>&1; then
	echo 'quota ?'
	exit 0
fi

jq -r '
	# Timestamps carry fractional seconds and a numeric offset, neither of
	# which fromdateiso8601 accepts.
	def stamp: sub("\\.[0-9]+"; "") | sub("\\+00:00"; "Z") | fromdateiso8601;

	# The leading space belongs to the reset, so a limit that has not started a
	# window yet — which the API reports as a null reset — does not leave a
	# stray space behind.
	def until($t):
		if $t == null then ""
		else
			(($t | stamp) - now) as $s
			| " " + if $s <= 0 then "now"
				elif $s < 3600 then "\(($s / 60) | floor)m"
				elif $s < 86400 then "\(($s / 3600) | floor)h"
				else "\(($s / 86400) | floor)d"
				end
		end;

	def limit(f): [.limits[] | select(f)][0] // null;

	# A limit missing from the response is dropped rather than shown as zero.
	def cell($label; $limit):
		if $limit == null then empty
		else "\($label) \($limit.percent)%\(until($limit.resets_at))"
		end;

	[
		cell("Fable"; limit(.scope.model.display_name == "Fable")),
		cell("Total"; limit(.kind == "session"))
	]
	| join(" │ ")
	# Pad the right edge. herdr trims trailing whitespace from the command
	# output, so the space is anchored with a word joiner: it is not
	# whitespace, so the trim stops there, and it renders as zero width.
	| . + " \u2060"
' "$cache"
