[alias]
	a   = !git ls-files -m -o --exclude-standard | fzf --preview 'git diff --color=always {}' --print0 -m | xargs -0 -t -o git add --patch
	ab  = absorb --and-rebase
	ap  = add --patch
	b   = !git for-each-ref --count=30 --sort=-committerdate refs/heads/ --format='%(refname:short)' | fzf --no-hscroll --no-multi --ansi --preview 'git --no-pager log -50 --pretty=format:\"%h  %an (%ar)  %s\" {}' --print0 | xargs -0 -t -o git switch
	c   = commit
	ca  = commit --amend
	cp  = cherry-pick
	d   = diff
	f   = fetch
	fp  = pull --ff-only
	l   = log --graph --stat
	ll  = log -p
	p   = pull
	pu  = push
	r   = rebase
	ra  = rebase --abort
	rc  = rebase --continue
	ri  = rebase --interactive
	rr  = restore --patch
	rs  = rebase --skip
	s   = status --short --branch
	st  = stash
	sl  = "!git stash list --pretty='%C(yellow)%gd %<(14)%Cgreen%cr %C(blue)%gs' | fzf --ansi --no-multi --preview 'git stash show --color=always -p {1}' | cut -f 1 -d ' ' | xargs -t -o git stash branch stash-$(date +%Y%m%d%H%M)"
	su  = !git branch --set-upstream-to=origin/`git symbolic-ref --short HEAD`
	sw  = switch
[bash]
	showInformativeStatus = true
[branch]
	sort = -committerdate
[color]
	status = auto
	ui = true
[color "status"]
	added = green
	changed = yellow
	deleted = red
	untracked = magenta
[column]
	ui = auto
[commit]
	gpgsign = true
[core]
	excludesfile = ~/.gitignore_global
	editor = nvim +start
	pager = delta
[delta]
	# Skip the OSC 10/11 terminal background query, which leaks into the pager input.
	dark = true
[diff]
	algorithm = histogram
	colorMoved = default
[fetch]
	prune = true
[filter "media"]
	clean = git-media-clean %f
	smudge = git-media-smudge %f
[gpg]
	format = ssh
[gpg "ssh"]
	allowedSignersFile = ~/.ssh/git_allowed_signers
[help]
	autocorrect = prompt
[init]
	defaultBranch = main
[interactive]
	diffFilter = delta --color-only --features=interactive
[merge]
	conflictStyle = zdiff3
[pager]
	difftool = true
[pull]
	rebase = true
[push]
	autoSetupRemote = true
[rebase]
	autoStash = true
	updateRefs = true
[rerere]
	enabled = true
[tag]
	gpgSign = true
[user]
	name = chriszarate
	email = chris@zarate.org
	signingkey = ~/.ssh/keys/commit_signing
[includeIf "hasconfig:remote.*.url:https://github.com/Automattic/**"]
	path = ~/.dotfiles/git/gitconfig-a8c
[includeIf "hasconfig:remote.*.url:git@github.com:Automattic/**"]
	path = ~/.dotfiles/git/gitconfig-a8c
[includeIf "hasconfig:remote.*.url:ssh://git@github.com/Automattic/**"]
	path = ~/.dotfiles/git/gitconfig-a8c
[includeIf "hasconfig:remote.*.url:https://github.com/WordPress/**"]
	path = ~/.dotfiles/git/gitconfig-a8c
[includeIf "hasconfig:remote.*.url:git@github.com:WordPress/**"]
	path = ~/.dotfiles/git/gitconfig-a8c
[includeIf "hasconfig:remote.*.url:ssh://git@github.com/WordPress/**"]
	path = ~/.dotfiles/git/gitconfig-a8c
