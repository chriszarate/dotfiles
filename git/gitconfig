[alias]
	a   = !git ls-files -m --exclude-standard | fzf --preview 'git diff --color=always {}' --print0 -m | xargs -0 -t -o git add --patch
	ap  = add --patch
	b   = !git for-each-ref --count=30 --sort=-committerdate refs/heads/ --format='%(refname:short)' | fzf --no-hscroll --no-multi --ansi --preview 'git --no-pager log -50 --pretty=format:\"%h  %an (%ar)  %s\" {}' --print0 | xargs -0 -t -o git switch
	c   = commit
	ca  = commit --amend
	cp  = cherry-pick
	d   = diff
	ds  = !DELTA_FEATURES=+side-by-side git diff
	f   = fetch
	fp  = pull --ff-only
	l   = log --graph --stat
	ll  = log -p
	p   = pull
	pu  = push
	r   = rebase
	ra  = rebase --abort
	rc  = rebase --continue
	ri  = rebase --interactive
	rr  = restore --patch
	rs  = rebase --skip
	s   = status --short --branch
	st  = stash
	sl  = "!git stash list --pretty='%C(yellow)%gd %<(14)%Cgreen%cr %C(blue)%gs' | fzf --ansi --no-multi --preview 'git stash show --color=always -p {1}' | cut -f 1 -d ' ' | xargs -t -o git stash branch stash-$(date +%Y%m%d%H%M)"
	su  = !git branch --set-upstream-to=origin/`git symbolic-ref --short HEAD`
	sw  = switch
[bash]
	showInformativeStatus = true
[color]
	status = auto
	ui = true
[color "status"]
	added = green
	changed = yellow
	deleted = red
	untracked = magenta
[commit]
	gpgsign = true
[core]
	excludesfile = ~/.gitignore_global
	editor = vim +start
	compression = 0
	pager = delta
[diff]
	algorithm = patience
	colorMoved = default
[filter "media"]
	clean = git-media-clean %f
	smudge = git-media-smudge %f
[gpg]
	format = ssh
[gpg "ssh"]
	allowedSignersFile = ~/.ssh/git_allowed_signers
[init]
	defaultBranch = main
[interactive]
	diffFilter = delta --color-only --features=interactive
[pack]
	windowMemory = 10m
	packSizeLimit = 20m
[pager]
	difftool = true
[push]
	autoRemoteSetup = true
	autoSetupRemote = true
[user]
	name = chriszarate
	email = chris.zarate@automattic.com
	signingkey = ~/.ssh/autoproxxy.pub
[help]
	autocorrect = prompt
